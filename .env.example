# OpenRouter credentials — copy this file to `.env` and fill in your key.
# Never commit `.env` (it is git-ignored).
OPENROUTER_API_KEY=sk-or-v1-...

# Model slug, see https://openrouter.ai/models
# Free models end with ":free" — no credits needed.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Tried in order when the primary model fails (rate limit, outage, …)
OPENROUTER_FALLBACK_MODELS=particle-ai/particle-1:free,openrouter/free
# Best quality (paid) alternative:
# OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Optional: shown on OpenRouter leaderboards
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=opencode

# Optional: Local Ollama URL (default: http://127.0.0.1:11434)
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional: web server port
PORT=3000

# Optional: "catalog" uses the committed data/free-models.json list and never
# contacts OpenRouter for it (useful offline). Leave empty for live + fallback.
# MODELS_SOURCE=catalog
