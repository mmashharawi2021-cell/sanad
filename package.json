{
  "name": "opencode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "chat": "tsx src/cli.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "models:refresh": "tsx scripts/refresh-models.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --test tests/ && node scripts/test-instant-commands.mjs && node scripts/test-command-registry.mjs",
    "test:commands": "node scripts/test-instant-commands.mjs && node scripts/test-command-registry.mjs",
    "test:ui": "node tests/ui/ui-smoke.mjs",
    "test:e2e": "node tests/e2e/offline-e2e.mjs",
    "offline:setup": "node scripts/offline-setup.mjs",
    "offline:check": "node scripts/offline-check.mjs"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.4.0",
    "@types/pdf-parse": "^1.1.5",
    "dotenv": "^17.2.3",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
